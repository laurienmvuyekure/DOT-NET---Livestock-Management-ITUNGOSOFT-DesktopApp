<Window x:Class="ItungoSoft.Farmer.Views.LegacyMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITUNGOSOFT - Farmer Module" Width="1050" Height="680" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Log out" Padding="12,2" Click="Logout_Click"/>
            <TextBlock x:Name="Welcome" FontSize="18" FontWeight="SemiBold" Foreground="#2E7D32"/>
        </DockPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="Dashboard">
                <Grid DataContext="{Binding Farm}" Margin="8">
					<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <WrapPanel.Resources>
                            <Style TargetType="Border"><Setter Property="Width" Value="190"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="BorderBrush" Value="#2E7D32"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
                        </WrapPanel.Resources>
                        <Border><StackPanel><TextBlock Text="Total animals"/><TextBlock Text="{Binding TotalAnimals}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Upcoming vaccinations"/><TextBlock Text="{Binding UpcomingVaccinations}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Pending consultations"/><TextBlock Text="{Binding PendingConsultations}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Active listings"/><TextBlock Text="{Binding ActiveListings}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                    </WrapPanel>
					<UniformGrid Grid.Row="1" Rows="2" Columns="2" Height="360">
						<Border BorderBrush="#DDD" BorderThickness="1" Margin="0,0,6,6">
							<Canvas x:Name="BarCanvas" ClipToBounds="True"/>
						</Border>
						<Border BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,6">
							<Canvas x:Name="PivotCanvas" ClipToBounds="True"/>
						</Border>
						<Border BorderBrush="#DDD" BorderThickness="1" Margin="0,0,6,0">
							<Canvas x:Name="TrendCanvas" ClipToBounds="True"/>
						</Border>
						<Border BorderBrush="#DDD" BorderThickness="1">
							<Canvas x:Name="HistCanvas" ClipToBounds="True"/>
						</Border>
					</UniformGrid>
					<DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="Recent activity" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding Activity}"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Animals">
                <DockPanel Margin="8" DataContext="{Binding Animals}">
        <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,14,0">
            <TextBlock Text="Register animal" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Ear tag"/>
            <TextBox Text="{Binding EarTag, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
            <TextBlock Text="Type"/>
            <ComboBox ItemsSource="{Binding AnimalTypes}" SelectedItem="{Binding SelectedType}" Margin="0,2,0,6"/>
            <TextBlock Text="Breed"/>
            <TextBox Text="{Binding Breed}" Margin="0,2,0,6"/>
            <TextBlock Text="Gender"/>
            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" Margin="0,2,0,6"/>
            <TextBlock Text="Date of birth"/>
            <DatePicker SelectedDate="{Binding DateOfBirth}" Margin="0,2,0,10"/>
            <Button Content="{Binding SaveLabel}" Command="{Binding AddCommand}" Padding="0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Photo..." Command="{Binding ChoosePhotoCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <Button Content="Edit selected" Command="{Binding EditCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <Button Content="Cancel edit" Command="{Binding CancelEditCommand}" Padding="8,2"/>
            </StackPanel>
            <Image Source="{Binding PhotoPath}" Height="90" Margin="0,8,0,0"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="Selected: " FontWeight="Bold"/><Run Text="{Binding Selected.EarTag, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Selected.Type, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Selected.Breed, Mode=OneWay}"/></TextBlock>
            <TextBlock Text="{Binding Message}" Foreground="DarkSlateGray" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Delete selected" Command="{Binding DeleteCommand}" Padding="10,2" Margin="8,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Run Text="Total: "/><Run Text="{Binding Total, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by ear tag, breed or type"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding Animals}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ear tag" Binding="{Binding EarTag}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Breed" Binding="{Binding Breed}" Width="*"/>
                    <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="*"/>
                    <DataGridTextColumn Header="Date of birth" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="Health">
                <DockPanel Margin="8" DataContext="{Binding Farm}">
                    <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,14,0">
                        <TextBlock Text="Health record / schedule" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Animal (also filters the list)"/>
                        <ComboBox ItemsSource="{Binding AnimalList}" DisplayMemberPath="EarTag" SelectedItem="{Binding HealthAnimal}" Margin="0,2,0,2"/>
                        <Button Content="Show all animals" Command="{Binding ClearFilterCommand}" Margin="0,0,0,6"/>
                        <TextBlock Text="Type"/>
                        <ComboBox ItemsSource="{Binding HealthKinds}" SelectedItem="{Binding Kind}" Margin="0,2,0,6"/>
                        <TextBlock Text="Description"/>
                        <TextBox Text="{Binding Description}" Margin="0,2,0,6"/>
                        <TextBlock Text="Date (done or scheduled)"/>
                        <DatePicker SelectedDate="{Binding HealthDate}" Margin="0,2,0,6"/>
                        <CheckBox Content="Already done (untick to schedule)" IsChecked="{Binding Done}" Margin="0,0,0,10"/>
                        <Button Content="Save" Command="{Binding AddHealthCommand}" Padding="0,4"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Mark done" Command="{Binding MarkDoneCommand}" Padding="10,2" Margin="0,0,8,0"/>
                            <Button Content="Delete selected" Command="{Binding DeleteHealthCommand}" Padding="10,2"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Health}" SelectedItem="{Binding SelectedHealth}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Animal" Binding="{Binding Animal.EarTag}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="Breeding">
                <DockPanel Margin="8" DataContext="{Binding Farm}">
                    <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,14,0">
                        <TextBlock Text="Record mating" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Female animal"/>
                        <ComboBox ItemsSource="{Binding AnimalList}" DisplayMemberPath="EarTag" SelectedItem="{Binding Dam}" Margin="0,2,0,6"/>
                        <TextBlock Text="Male (ear tag)"/>
                        <TextBox Text="{Binding Sire}" Margin="0,2,0,6"/>
                        <TextBlock Text="Method"/>
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Margin="0,2,0,6"/>
                        <TextBlock Text="Mating date"/>
                        <DatePicker SelectedDate="{Binding MatingDate}" Margin="0,2,0,10"/>
                        <Button Content="Save mating" Command="{Binding AddBreedingCommand}" Padding="0,4"/>
                        <TextBlock Text="Birth outcome (select a row first)" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding Outcome}" Margin="0,0,0,6"/>
                        <Button Content="Record outcome" Command="{Binding RecordOutcomeCommand}" Padding="0,4"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Breeding}" SelectedItem="{Binding SelectedBreeding}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Female" Binding="{Binding Animal.EarTag}" Width="*"/>
                            <DataGridTextColumn Header="Male" Binding="{Binding SireEarTag}" Width="*"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/>
                            <DataGridTextColumn Header="Mated" Binding="{Binding MatingDate, StringFormat=dd/MM/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="Expected delivery" Binding="{Binding ExpectedDelivery, StringFormat=dd/MM/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock><Run Text="Notifications ("/><Run Text="{Binding Farm.Unread, Mode=OneWay}"/><Run Text=")"/></TextBlock></TabItem.Header>
                <DockPanel Margin="8" DataContext="{Binding Farm}">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Mark all as read" Command="{Binding MarkAllReadCommand}" Padding="10,2" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Notifications}">
                        <ListBox.ItemTemplate><DataTemplate>
                            <TextBlock><Run Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm, Mode=OneWay}" Foreground="Gray"/><Run Text="  "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Consultations">
                <DockPanel Margin="8" DataContext="{Binding Extras}">
                    <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,14,0">
                        <TextBlock Text="New consultation request" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Animal"/>
                        <ComboBox ItemsSource="{Binding AnimalList}" DisplayMemberPath="EarTag" SelectedItem="{Binding ConsAnimal}" Margin="0,2,0,6"/>
                        <TextBlock Text="Subject"/>
                        <TextBox Text="{Binding Subject}" Margin="0,2,0,6"/>
                        <TextBlock Text="Description"/>
                        <TextBox Text="{Binding ConsDescription}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8"/>
                        <Button Content="Submit request" Command="{Binding AddConsultationCommand}" Padding="0,4"/>
                        <TextBlock Text="Veterinary response (select a row first)" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding Response}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6"/>
                        <Button Content="Save response" Command="{Binding SaveResponseCommand}" Padding="0,4"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Consultations}" SelectedItem="{Binding SelectedConsultation}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="Animal" Binding="{Binding AnimalTag}" Width="*"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Listings">
                <DockPanel Margin="8" DataContext="{Binding Extras}">
                    <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,14,0">
                        <TextBlock Text="List an animal for sale" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Animal"/>
                        <ComboBox ItemsSource="{Binding AnimalList}" DisplayMemberPath="EarTag" SelectedItem="{Binding ListAnimal}" Margin="0,2,0,6"/>
                        <TextBlock Text="Price (RWF)"/>
                        <TextBox Text="{Binding Price}" Margin="0,2,0,6"/>
                        <TextBlock Text="Description"/>
                        <TextBox Text="{Binding ListDescription}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8"/>
                        <Button Content="Create listing" Command="{Binding AddListingCommand}" Padding="0,4"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Activate / deactivate" Command="{Binding ToggleListingCommand}" Padding="10,2" Margin="0,0,8,0"/>
                            <Button Content="Delete selected" Command="{Binding DeleteListingCommand}" Padding="10,2"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Listings}" SelectedItem="{Binding SelectedListing}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Animal" Binding="{Binding AnimalTag}" Width="*"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="Reports &amp; Data">
                <StackPanel Margin="8" Width="320" HorizontalAlignment="Left" DataContext="{Binding Extras}">
                    <TextBlock Text="PDF reports" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="Animal population report" Command="{Binding PopulationPdfCommand}" Padding="0,4" Margin="0,0,0,6"/>
                    <Button Content="Health summary report" Command="{Binding HealthPdfCommand}" Padding="0,4" Margin="0,0,0,6"/>
                    <Button Content="Breeding performance report" Command="{Binding BreedingPdfCommand}" Padding="0,4" Margin="0,0,0,14"/>
                    <TextBlock Text="Export" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="Export animals and health data (CSV)" Command="{Binding ExportCsvCommand}" Padding="0,4" Margin="0,0,0,14"/>
                    <TextBlock Text="Backup and restore" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="Backup database" Command="{Binding BackupCommand}" Padding="0,4" Margin="0,0,0,6"/>
                    <Button Content="Restore database" Command="{Binding RestoreCommand}" Padding="0,4" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Profile">
                <StackPanel Margin="8" Width="300" HorizontalAlignment="Left" DataContext="{Binding Extras}">
                    <TextBlock Text="Full name"/>
                    <TextBox Text="{Binding FullName}" Margin="0,2,0,6"/>
                    <TextBlock Text="Username"/>
                    <TextBox Text="{Binding Username}" Margin="0,2,0,6"/>
                    <Button Content="Save profile" Command="{Binding SaveProfileCommand}" Padding="0,4"/>
                    <TextBlock Text="Change password" FontWeight="Bold" Margin="0,18,0,6"/>
                    <TextBlock Text="Current password"/>
                    <PasswordBox x:Name="OldPw" Margin="0,2,0,6"/>
                    <TextBlock Text="New password (6+ characters)"/>
                    <PasswordBox x:Name="NewPw" Margin="0,2,0,6"/>
                    <Button Content="Change password" Click="ChangePassword_Click" Padding="0,4"/>
                    <TextBlock x:Name="PwMsg" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
