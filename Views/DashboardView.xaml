<UserControl x:Class="ItungoSoft.Farmer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ItungoSoft.Farmer.Views">

    <!-- 100% Window-Fitted Layout (Zero Outer Scrolling) -->
    <Grid Margin="0,4,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Compact Sliding Hero Carousel (~105px) -->
        <views:HeroSliderView Grid.Row="0" DataContext="{Binding Slider}"/>

        <!-- Row 1: Four Pastel Stat Cards (~68px) -->
        <views:StatsView Grid.Row="1" DataContext="{Binding}"/>

        <!-- Row 2: Two Columns Filling 100% of Remaining Height -->
        <Grid Grid.Row="2" Margin="20,4,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Procedural Chart Analytics (Fills Available Height) -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="14" Padding="14,12">
                <DockPanel>
                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Herd Analytics &amp; Demographics"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Reports"
                                Padding="8,3">
                            <TextBlock Text="Full Reports" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </DockPanel>

                    <!-- 2x2 Canvas Charts (Automatically Scale to Fill Space) -->
                    <UniformGrid x:Name="ChartGrid" Rows="2" Columns="2">
                        <!-- Chart 1: Animals by Type -->
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,4,4" Background="{DynamicResource SurfaceSecondary}">
                            <Canvas x:Name="BarCanvas" ClipToBounds="True"/>
                        </Border>

                        <!-- Chart 2: Pivot Type x Gender -->
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Margin="4,0,0,4" Background="{DynamicResource SurfaceSecondary}">
                            <Canvas x:Name="PivotCanvas" ClipToBounds="True"/>
                        </Border>

                        <!-- Chart 3: Health records per month trend -->
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Margin="0,4,4,0" Background="{DynamicResource SurfaceSecondary}">
                            <Canvas x:Name="TrendCanvas" ClipToBounds="True"/>
                        </Border>

                        <!-- Chart 4: Age distribution histogram -->
                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Margin="4,4,0,0" Background="{DynamicResource SurfaceSecondary}">
                            <Canvas x:Name="HistCanvas" ClipToBounds="True"/>
                        </Border>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <!-- Right Column: Recent Farm Activity & Quick Actions -->
            <Border Grid.Column="1" Margin="8,0,0,0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="14" Padding="14,12">
                <DockPanel>
                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Recent Farm Activity"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Health"
                                Padding="8,3">
                            <TextBlock Text="All Health" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </DockPanel>

                    <!-- Quick Actions Toolbar Docked at Bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Separator Background="{DynamicResource BorderSubtle}" Margin="0,0,0,8"/>
                        <UniformGrid Rows="1" Columns="2">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Animals"
                                    Style="{StaticResource AccentButton}" Margin="0,0,4,0" Padding="8,6">
                                <TextBlock Text="+ Add Animal" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Breeding"
                                    Style="{StaticResource PillButton}" Margin="4,0,0,0" Padding="8,6">
                                <TextBlock Text="+ Record Mating" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Activity Items List (Live from PostgreSQL Database) -->
                    <ListBox ItemsSource="{Binding Farm.Activity}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceSecondary}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Activity Indicator Dot -->
                                        <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                                Background="{DynamicResource Accent}" Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}"
                                                   FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
