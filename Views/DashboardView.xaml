<UserControl x:Class="ItungoSoft.Farmer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ItungoSoft.Farmer.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">

            <!-- 1. Sliding Hero Banner Carousel -->
            <views:HeroSliderView DataContext="{Binding Slider}"/>

            <!-- 2. Four Pastel Stat Cards (Total animals, Vaccinations, Consultations, Listings) -->
            <views:StatsView DataContext="{Binding}"/>

            <!-- 3. Two Columns: Live Charts (Left) & Recent Farm Activity (Right) -->
            <Grid Margin="24,6,24,0" MinHeight="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Procedural Chart Analytics -->
                <Border Grid.Column="0" Margin="0,0,12,0"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="16" Padding="18">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Herd Analytics &amp; Demographics"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Reports"
                                    Padding="10,4">
                                <TextBlock Text="Full Reports" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </DockPanel>

                        <!-- 2x2 Canvas Charts -->
                        <UniformGrid x:Name="ChartGrid" Rows="2" Columns="2" MinHeight="320">
                            <!-- Chart 1: Animals by Type -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="10" Margin="0,0,6,6" Background="{DynamicResource SurfaceSecondary}">
                                <Canvas x:Name="BarCanvas" ClipToBounds="True"/>
                            </Border>

                            <!-- Chart 2: Pivot Type x Gender -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="10" Margin="6,0,0,6" Background="{DynamicResource SurfaceSecondary}">
                                <Canvas x:Name="PivotCanvas" ClipToBounds="True"/>
                            </Border>

                            <!-- Chart 3: Health records per month trend -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="10" Margin="0,6,6,0" Background="{DynamicResource SurfaceSecondary}">
                                <Canvas x:Name="TrendCanvas" ClipToBounds="True"/>
                            </Border>

                            <!-- Chart 4: Age distribution histogram -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="10" Margin="6,6,0,0" Background="{DynamicResource SurfaceSecondary}">
                                <Canvas x:Name="HistCanvas" ClipToBounds="True"/>
                            </Border>
                        </UniformGrid>
                    </DockPanel>
                </Border>

                <!-- Right Column: Recent Farm Activity & Quick Actions -->
                <Border Grid.Column="1" Margin="12,0,0,0"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="16" Padding="18">
                    <DockPanel>
                        <!-- Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <TextBlock Text="Recent Farm Activity"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Health"
                                    Padding="10,4">
                                <TextBlock Text="All Health" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </DockPanel>

                        <!-- Quick Actions Toolbar at bottom -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Separator Background="{DynamicResource BorderSubtle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Quick Actions" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <UniformGrid Rows="1" Columns="2">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Animals"
                                        Style="{StaticResource AccentButton}" Margin="0,0,4,0" Padding="10,8">
                                    <TextBlock Text="+ Add Animal" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Breeding"
                                        Style="{StaticResource PillButton}" Margin="4,0,0,0" Padding="10,8">
                                    <TextBlock Text="+ Record Mating" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Activity Items List (Live from PostgreSQL Database) -->
                        <ListBox ItemsSource="{Binding Farm.Activity}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceSecondary}"
                                            BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="10" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Green Dot / Activity Indicator -->
                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                    Background="{DynamicResource Accent}" Margin="0,0,10,0"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                       FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
