<Window x:Class="ItungoSoft.Farmer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ItungoSoft.Farmer.Views"
        xmlns:behaviors="clr-namespace:ItungoSoft.Farmer.Behaviors"
        behaviors:ProximityBehavior.IsEnabled="True"
        Title="ITUNGOSOFT — Farmer Command Center"
        Width="1240" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStyle="None"
        AllowsTransparency="True">

    <!-- WindowChrome for Modern Rounded Borderless Window with Native Resize & Drag -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="16"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Global Key Bindings for Accessibility & Fast Navigation (Ctrl+1..9, Ctrl+T) -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="Animals"/>
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="Health"/>
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="Breeding"/>
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="Consultations"/>
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="Listings"/>
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="Notifications"/>
        <KeyBinding Modifiers="Ctrl" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="Profile"/>
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding ToggleThemeCommand}"/>
    </Window.InputBindings>

    <!-- Outer Rounded Window Border Shell -->
    <Border Background="{DynamicResource Background}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Left Sidebar (Fixed 230px) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,1,0">
                <views:SidebarView DataContext="{Binding}"/>
            </Border>

            <!-- 2. Main Content Area (Top Bar + Dynamic View Panes) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar & Window Control Buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <views:TopBarView x:Name="TopBar" Grid.Column="0" DataContext="{Binding}"/>

                    <!-- Accessible Custom Window Chrome Buttons (Min, Max, Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,12,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button Click="Minimize_Click"
                                Style="{StaticResource IconButton}"
                                Width="34" Height="30" Padding="0"
                                AutomationProperties.Name="Minimize Window"
                                AutomationProperties.HelpText="Minimizes the ITUNGOSOFT application">
                            <Path Width="10" Height="2" Fill="{DynamicResource TextSecondary}" Stretch="Uniform"
                                  Data="M0 0 H10 V2 H0 Z"/>
                        </Button>

                        <Button Click="Maximize_Click"
                                Style="{StaticResource IconButton}"
                                Width="34" Height="30" Padding="0"
                                AutomationProperties.Name="Maximize or Restore Window"
                                AutomationProperties.HelpText="Toggles full screen and normal window size">
                            <Path Width="10" Height="10" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Stretch="Uniform"
                                  Data="M1 1 H9 V9 H1 Z"/>
                        </Button>

                        <Button Click="Close_Click"
                                Style="{StaticResource IconButton}"
                                Width="34" Height="30" Padding="0"
                                AutomationProperties.Name="Close Window"
                                AutomationProperties.HelpText="Closes the application">
                            <Path Width="10" Height="10" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Stretch="Uniform"
                                  Data="M1 1 L9 9 M9 1 L1 9"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Dynamic View Area: Controlled by ActiveSection -->
                <Grid Grid.Row="1">

                    <!-- 1. Dashboard View (Sliding Carousel, 4 Pastel Stats, Charts & Recent Activity) -->
                    <views:DashboardView x:Name="DashboardPane" DataContext="{Binding}">
                        <views:DashboardView.Style>
                            <Style TargetType="views:DashboardView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:DashboardView.Style>
                    </views:DashboardView>

                    <!-- 2. Animals Registry View (Animal CRUD, Filter, Photo Preview, DataGrid) -->
                    <views:AnimalsView DataContext="{Binding}">
                        <views:AnimalsView.Style>
                            <Style TargetType="views:AnimalsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Animals">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:AnimalsView.Style>
                    </views:AnimalsView>

                    <!-- 3. Health & Vaccinations View -->
                    <views:HealthView DataContext="{Binding}">
                        <views:HealthView.Style>
                            <Style TargetType="views:HealthView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Health">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:HealthView.Style>
                    </views:HealthView>

                    <!-- 4. Breeding & Reproduction View -->
                    <views:BreedingView DataContext="{Binding}">
                        <views:BreedingView.Style>
                            <Style TargetType="views:BreedingView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Breeding">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:BreedingView.Style>
                    </views:BreedingView>

                    <!-- 5. Veterinary Consultations View -->
                    <views:ConsultationsView DataContext="{Binding}">
                        <views:ConsultationsView.Style>
                            <Style TargetType="views:ConsultationsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Consultations">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ConsultationsView.Style>
                    </views:ConsultationsView>

                    <!-- 6. Livestock Marketplace Listings View -->
                    <views:ListingsView DataContext="{Binding}">
                        <views:ListingsView.Style>
                            <Style TargetType="views:ListingsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Listings">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ListingsView.Style>
                    </views:ListingsView>

                    <!-- 7. Reports & Data Export View -->
                    <views:ReportsView DataContext="{Binding}">
                        <views:ReportsView.Style>
                            <Style TargetType="views:ReportsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Reports">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ReportsView.Style>
                    </views:ReportsView>

                    <!-- 8. Herd Notifications View -->
                    <views:NotificationsView DataContext="{Binding}">
                        <views:NotificationsView.Style>
                            <Style TargetType="views:NotificationsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Notifications">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:NotificationsView.Style>
                    </views:NotificationsView>

                    <!-- 9. Profile & Password Security View -->
                    <views:ProfileView DataContext="{Binding}">
                        <views:ProfileView.Style>
                            <Style TargetType="views:ProfileView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Profile">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ProfileView.Style>
                    </views:ProfileView>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
