<UserControl x:Class="ItungoSoft.Farmer.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fitted Layout (Zero Outer Scrolling) -->
    <Grid Margin="20,12,20,16" DataContext="{Binding Extras}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Farmer Account Profile &amp; Security Settings"
                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,14"/>

        <!-- 2 Side-by-Side Account Management Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Farmer Profile Details -->
            <Border Grid.Column="0" Margin="0,0,10,0" Padding="20,18" CornerRadius="14"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Farmer Profile Details"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>

                    <!-- Save Profile Button Docked at Bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Button Content="Save Profile Information"
                                Command="{Binding SaveProfileCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Padding="20,8" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Accent}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Input Fields -->
                    <StackPanel>
                        <TextBlock Text="Full Name *" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FullName}" Padding="8,5" Margin="0,0,0,14"/>

                        <TextBlock Text="Username *" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Username}" Padding="8,5" Margin="0,0,0,10"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 2: Security & Password Change -->
            <Border Grid.Column="1" Margin="10,0,0,0" Padding="20,18" CornerRadius="14"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <DockPanel>
                    <!-- Header & Subtitle -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Security &amp; Change Password" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Ensure your new password contains at least 6 characters."
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>

                    <!-- Update Password Button Docked at Bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Button Content="Update Password"
                                Click="ChangePassword_Click"
                                Style="{StaticResource PillButton}"
                                HorizontalAlignment="Left" Padding="20,8" Margin="0,0,0,8"/>

                        <TextBlock x:Name="PwMsg" Foreground="{DynamicResource Accent}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Input Fields -->
                    <StackPanel>
                        <TextBlock Text="Current Password *" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="OldPw" Padding="8,5" Margin="0,0,0,14"/>

                        <TextBlock Text="New Password (6+ characters) *" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="NewPw" Padding="8,5" Margin="0,0,0,10"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
