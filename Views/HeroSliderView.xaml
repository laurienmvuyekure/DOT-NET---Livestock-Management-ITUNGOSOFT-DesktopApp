<UserControl x:Class="ItungoSoft.Farmer.Views.HeroSliderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ItungoSoft.Farmer.Models"
             Focusable="True"
             AutomationProperties.Name="Hero Feature Carousel"
             AutomationProperties.LiveSetting="Polite">

    <Grid x:Name="RootHeroContainer" Margin="20,6,20,6">
        <!-- Sleek Executive Banner Surface -->
        <Border Background="{DynamicResource HeroGradientBrush}"
                BorderBrush="{DynamicResource HeroBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                Padding="20,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Carousel Slide Content -->
                <StackPanel x:Name="SlideContentPanel" Grid.Column="0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </StackPanel.RenderTransform>

                    <!-- Line 1: Category Pill & Main Headline -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{DynamicResource BorderSubtle}"
                                CornerRadius="8" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentSlide.Category}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentSlide.Title}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Line 2: Description -->
                    <TextBlock Text="{Binding CurrentSlide.Description}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,8"/>

                    <!-- Line 3: Controls (CTA Button, Arrows, Dots, Slide Counter) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Action CTA Button -->
                        <Button Style="{StaticResource AccentButton}"
                                Command="{Binding CurrentSlide.ActionCommand}"
                                AutomationProperties.Name="{Binding CurrentSlide.ButtonText}"
                                Padding="12,5" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF" Margin="0,0,6,0"
                                      Data="M8 5V19L19 12L8 5Z"/>
                                <TextBlock Text="{Binding CurrentSlide.ButtonText}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Prev Button -->
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding PrevCommand}"
                                AutomationProperties.Name="Previous Slide"
                                Width="26" Height="26" Padding="0" Margin="0,0,4,0">
                            <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource TextSecondary}"
                                  Data="M15.41 7.41L14 6L8 12L14 18L15.41 16.59L10.83 12L15.41 7.41Z"/>
                        </Button>

                        <!-- Dot Indicators -->
                        <ItemsControl ItemsSource="{Binding Slides}" VerticalAlignment="Center" Margin="0,0,4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SlideItem}">
                                    <Button Command="{Binding DataContext.SelectSlideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Index}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Switch to slide {0}'}"
                                            Margin="3,0" Width="8" Height="8" Padding="0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Border}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Next Button -->
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding NextCommand}"
                                AutomationProperties.Name="Next Slide"
                                Width="26" Height="26" Padding="0" Margin="0,0,10,0">
                            <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource TextSecondary}"
                                  Data="M10 6L8.59 7.41L13.17 12L8.59 16.59L10 18L16 12L10 6Z"/>
                        </Button>

                        <!-- Slide Counter -->
                        <TextBlock Text="{Binding SlideNumberDisplay}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hidden Screen Reader Live Announcement -->
                    <TextBlock Text="{Binding Announcement}" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <!-- Right Column: Single Crisp Shield Badge -->
                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26"
                        Background="{DynamicResource SurfaceSecondary}"
                        BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1.5"
                        VerticalAlignment="Center" Margin="10,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="14" ShadowDepth="0" Opacity="0.3"/>
                    </Border.Effect>
                    <!-- Farm Shield Icon -->
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource Accent}"
                          Data="M12 2L4 6V12C4 16.5 7.5 20.5 12 22C16.5 20.5 20 16.5 20 12V6L12 2M12 4.2L18 7.2V11.8C18 15.2 15.5 18.3 12 19.8C8.5 18.3 6 15.2 6 11.8V7.2L12 4.2M12 7A3 3 0 0 0 9 10C9 11.3 9.8 12.4 11 12.8V16H13V12.8C14.2 12.4 15 11.3 15 10A3 3 0 0 0 12 7Z"/>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
