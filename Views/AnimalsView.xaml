<UserControl x:Class="ItungoSoft.Farmer.Views.AnimalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,14,24,24" DataContext="{Binding Animals}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Registration & Edit Form Card -->
        <Border Grid.Column="0" Margin="0,0,16,0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Animal Registration"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,14"/>

                    <!-- Ear Tag -->
                    <TextBlock Text="Ear Tag Number *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EarTag, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>

                    <!-- Type -->
                    <TextBlock Text="Species / Type *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AnimalTypes}"
                              SelectedItem="{Binding SelectedType}"
                              Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Breed -->
                    <TextBlock Text="Breed *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Breed}" Margin="0,0,0,12"/>

                    <!-- Gender -->
                    <TextBlock Text="Gender *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Genders}"
                              SelectedItem="{Binding Gender}"
                              Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Date of Birth -->
                    <TextBlock Text="Date of Birth *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DateOfBirth}" Margin="0,0,0,14"/>

                    <!-- Primary Save Button -->
                    <Button Content="{Binding SaveLabel}"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,10" Margin="0,0,0,10"/>

                    <!-- Secondary Action Buttons -->
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,12">
                        <Button Content="Photo..." Command="{Binding ChoosePhotoCommand}"
                                Style="{StaticResource PillButton}" Margin="0,0,4,0" Padding="0,6"/>
                        <Button Content="Edit" Command="{Binding EditCommand}"
                                Style="{StaticResource PillButton}" Margin="2,0,2,0" Padding="0,6"/>
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource PillButton}" Margin="4,0,0,0" Padding="0,6"/>
                    </UniformGrid>

                    <!-- Photo Preview Thumbnail -->
                    <Border Height="110" CornerRadius="10" Background="{DynamicResource SurfaceSecondary}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            ClipToBounds="True" Margin="0,0,0,12">
                        <Grid>
                            <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                            <TextBlock Text="No photo selected"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PhotoPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Selected Animal Info -->
                    <Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                            <Run Text="Selected: " FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <Run Text="{Binding Selected.EarTag, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding Selected.Type, Mode=OneWay}"/>
                            <Run Text=" | "/>
                            <Run Text="{Binding Selected.Breed, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Status / Validation Message -->
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Accent}"
                               TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: Search, Stats & Animals DataGrid Card -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <DockPanel>

                <!-- Top Bar: Search Filter, Total Counter & Delete Selected Button -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Delete Selected"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="14,6" Margin="10,0,0,0"/>

                    <Border DockPanel.Dock="Right" Background="{DynamicResource CardBlue}"
                            CornerRadius="8" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="Total Animals: " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="{Binding Total, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource CardBlueText}"/>
                        </TextBlock>
                    </Border>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by ear tag, breed or type"
                             Padding="10,8"/>
                </DockPanel>

                <!-- Animals DataGrid -->
                <DataGrid ItemsSource="{Binding Animals}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ear Tag" Binding="{Binding EarTag}" Width="1.2*"/>
                        <DataGridTextColumn Header="Species" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Breed" Binding="{Binding Breed}" Width="1.2*"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="0.9*"/>
                        <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="1.1*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

    </Grid>
</UserControl>
