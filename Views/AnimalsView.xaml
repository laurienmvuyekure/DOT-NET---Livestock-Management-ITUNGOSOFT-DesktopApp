<UserControl x:Class="ItungoSoft.Farmer.Views.AnimalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,12,20,16" DataContext="{Binding Animals}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Registration & Edit Form Card (Compact, Zero Page Scrolling) -->
        <Border Grid.Column="0" Margin="0,0,14,0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="16,14">
            <DockPanel>

                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Animal Registration"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,10"/>

                <!-- Action Buttons Docked at Bottom of Left Panel -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Save Button -->
                        <Button Grid.Column="0" Content="{Binding SaveLabel}"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource AccentButton}"
                                Padding="0,7" Margin="0,0,4,0"/>
                        <!-- Edit Button -->
                        <Button Grid.Column="1" Content="Edit" Command="{Binding EditCommand}"
                                Style="{StaticResource PillButton}" Margin="2,0,2,0" Padding="0,7"/>
                        <!-- Cancel Button -->
                        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource PillButton}" Margin="4,0,0,0" Padding="0,7"/>
                    </Grid>

                    <!-- Validation / Status Message -->
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Accent}"
                               TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Input Fields in 2-Column Responsive Form -->
                <StackPanel>
                    <!-- Row 1: Ear Tag & Species -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Ear Tag *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding EarTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Species *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AnimalTypes}"
                                      SelectedItem="{Binding SelectedType}"
                                      Padding="8,5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Breed & Gender -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Breed *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding Breed}" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Gender *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding Genders}"
                                      SelectedItem="{Binding Gender}"
                                      Padding="8,5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Date of Birth & Photo Button -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Date of Birth *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding DateOfBirth}" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Bottom">
                            <Button Content="Choose Photo" Command="{Binding ChoosePhotoCommand}"
                                    Style="{StaticResource PillButton}" Padding="0,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Photo Preview Thumbnail & Summary Row -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Photo Thumbnail -->
                        <Border Grid.Column="0" Height="60" CornerRadius="8" Background="{DynamicResource SurfaceSecondary}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                ClipToBounds="True" Margin="0,0,10,0">
                            <Grid>
                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                                <TextBlock Text="No photo" Foreground="{DynamicResource TextMuted}"
                                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PhotoPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <!-- Selected Summary -->
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="8,6"
                                VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                <Run Text="Selected: " FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <Run Text="{Binding Selected.EarTag, Mode=OneWay}" FontWeight="SemiBold"/>
                                <LineBreak/>
                                <Run Text="{Binding Selected.Type, Mode=OneWay}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding Selected.Breed, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Right Column: Search, Counter & DataGrid Card (Fills 100% Remaining Space) -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="16,14">
            <DockPanel>

                <!-- Top Bar: Search Filter, Counter & Delete Button -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Delete Selected"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="12,5" Margin="10,0,0,0"/>

                    <Border DockPanel.Dock="Right" Background="{DynamicResource CardBlue}"
                            CornerRadius="8" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="Total: " FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="{Binding Total, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource CardBlueText}"/>
                        </TextBlock>
                    </Border>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by ear tag, breed or species"
                             Padding="10,6"/>
                </DockPanel>

                <!-- Animals DataGrid -->
                <DataGrid ItemsSource="{Binding Animals}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ear Tag" Binding="{Binding EarTag}" Width="1.2*"/>
                        <DataGridTextColumn Header="Species" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Breed" Binding="{Binding Breed}" Width="1.2*"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="0.9*"/>
                        <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="1.1*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

    </Grid>
</UserControl>
