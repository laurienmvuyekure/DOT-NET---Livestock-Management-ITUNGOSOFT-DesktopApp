<UserControl x:Class="ItungoSoft.Farmer.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,14,24,24" DataContext="{Binding Farm}">
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="16" Padding="24">
            <DockPanel>

                <!-- Header & Mark All Read Toolbar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Herd Alerts &amp; Notifications"
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <Border Background="{DynamicResource Accent}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Unread, StringFormat={}{0} unread}"
                                       FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Content="Mark All as Read"
                            Command="{Binding MarkAllReadCommand}"
                            Style="{StaticResource AccentButton}"
                            Padding="16,8"/>
                </DockPanel>

                <!-- Notifications List -->
                <ListBox ItemsSource="{Binding Notifications}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceSecondary}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Bell Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                            Background="{DynamicResource CardBlue}" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource CardBlueText}"
                                              Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22M18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16Z"/>
                                    </Border>

                                    <!-- Message & Timestamp -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                                   FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="8"
                                            Background="{DynamicResource BorderSubtle}">
                                        <TextBlock Text="{Binding IsRead, Converter={x:Null}}" FontSize="11" Foreground="{DynamicResource TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Read"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                            <Setter Property="Text" Value="New Alert"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
