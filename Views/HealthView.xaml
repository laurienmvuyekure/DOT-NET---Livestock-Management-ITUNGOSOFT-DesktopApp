<UserControl x:Class="ItungoSoft.Farmer.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,12,20,16" DataContext="{Binding Farm}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Health Event Form Card (Fitted, Zero Page Scrolling) -->
        <Border Grid.Column="0" Margin="0,0,14,0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="16,14">
            <DockPanel>

                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Schedule / Record Health Event"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,10"/>

                <!-- Save & Status Docked at Bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="Save Health Record"
                            Command="{Binding AddHealthCommand}"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,8" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Accent}"
                               TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Compact 2-Column Inputs -->
                <StackPanel>
                    <!-- Row 1: Animal & Event Type -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Animal (Filters list) *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AnimalList}"
                                      DisplayMemberPath="EarTag"
                                      SelectedItem="{Binding HealthAnimal}"
                                      Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Event Type *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding HealthKinds}"
                                      SelectedItem="{Binding Kind}"
                                      Padding="8,5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filter Clear Button -->
                    <Button Content="Show All Animals"
                            Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left"
                            Padding="10,3" Margin="0,0,0,8"/>

                    <!-- Row 2: Description & Date -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Description / Notes *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding Description}" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Date (Done / Due) *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding HealthDate}" Padding="8,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Completed Checkbox -->
                    <CheckBox Content="Already Completed (untick to schedule)"
                              IsChecked="{Binding Done}"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="12" Margin="0,4,0,8"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Right Column: Health Events DataGrid Card (Fills 100% Height) -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="16,14">
            <DockPanel>

                <!-- Top Bar: Action Buttons -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mark Completed"
                                Command="{Binding MarkDoneCommand}"
                                Style="{StaticResource AccentButton}"
                                Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="Delete Selected"
                                Command="{Binding DeleteHealthCommand}"
                                Style="{StaticResource DangerButton}"
                                Padding="12,5"/>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Health}"
                          SelectedItem="{Binding SelectedHealth}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Animal" Binding="{Binding Animal.EarTag}" Width="*"/>
                        <DataGridTextColumn Header="Event Type" Binding="{Binding Kind}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>

    </Grid>
</UserControl>
