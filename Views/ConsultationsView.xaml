<UserControl x:Class="ItungoSoft.Farmer.Views.ConsultationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20,12,20,16" DataContext="{Binding Extras}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Request Form & Response Card (Fitted, Zero Page Scrolling) -->
        <Border Grid.Column="0" Margin="0,0,14,0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="16,14">
            <DockPanel>

                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Veterinary Tele-Consultation"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,10"/>

                <!-- Status Message Docked at Bottom -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="{DynamicResource Accent}"
                           TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>

                <!-- Form Controls -->
                <StackPanel>
                    <!-- Row 1: Animal & Subject -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Animal *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AnimalList}"
                                      DisplayMemberPath="EarTag"
                                      SelectedItem="{Binding ConsAnimal}"
                                      Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Subject *" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding Subject}" Padding="8,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Clinical Description *" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding ConsDescription}" Height="48"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                    <!-- Submit Button -->
                    <Button Content="Submit Request"
                            Command="{Binding AddConsultationCommand}"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,7" Margin="0,0,0,10"/>

                    <Separator Background="{DynamicResource BorderSubtle}" Margin="0,0,0,8"/>

                    <!-- Vet Response Section -->
                    <TextBlock Text="Veterinary Response (select row first)" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,3"/>

                    <TextBox Text="{Binding Response}" Height="48"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                    <Button Content="Save Response"
                            Command="{Binding SaveResponseCommand}"
                            Style="{StaticResource PillButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,6" Margin="0,0,0,4"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Right Column: Consultations DataGrid Card (Fills 100% Height) -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="14" Padding="16,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Consultation Inquiries &amp; Doctor Notes"
                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,12"/>

                <DataGrid ItemsSource="{Binding Consultations}"
                          SelectedItem="{Binding SelectedConsultation}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="*"/>
                        <DataGridTextColumn Header="Animal" Binding="{Binding AnimalTag}" Width="*"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="1.5*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
