<UserControl x:Class="ItungoSoft.Farmer.Views.BreedingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,14,24,24" DataContext="{Binding Farm}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Mating Form & Birth Outcome Card -->
        <Border Grid.Column="0" Margin="0,0,16,0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Breeding &amp; Reproduction"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,14"/>

                    <!-- Female Animal (Dam) -->
                    <TextBlock Text="Female Animal (Dam) *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AnimalList}"
                              DisplayMemberPath="EarTag"
                              SelectedItem="{Binding Dam}"
                              Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Male Sire Ear Tag -->
                    <TextBlock Text="Male Sire (Ear Tag) *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Sire}" Margin="0,0,0,12"/>

                    <!-- Method -->
                    <TextBlock Text="Breeding Method *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Methods}"
                              SelectedItem="{Binding Method}"
                              Padding="8,6" Margin="0,0,0,12"/>

                    <!-- Mating Date -->
                    <TextBlock Text="Mating Date *" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding MatingDate}" Margin="0,0,0,14"/>

                    <!-- Save Mating Button -->
                    <Button Content="Save Mating Record"
                            Command="{Binding AddBreedingCommand}"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,10" Margin="0,0,0,18"/>

                    <Separator Background="{DynamicResource BorderSubtle}" Margin="0,0,0,14"/>

                    <!-- Birth Outcome Section -->
                    <TextBlock Text="Record Birth Outcome" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Select a breeding record row first" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                    <TextBox Text="{Binding Outcome}" Margin="0,0,0,10"
                             ToolTip="e.g. 1 healthy male calf, Twins, etc."/>

                    <Button Content="Record Birth Outcome"
                            Command="{Binding RecordOutcomeCommand}"
                            Style="{StaticResource PillButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,8" Margin="0,0,0,12"/>

                    <!-- Message -->
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Accent}"
                               TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Column: Breeding DataGrid Card -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Breeding &amp; Gestation Registry"
                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,16"/>

                <DataGrid ItemsSource="{Binding Breeding}"
                          SelectedItem="{Binding SelectedBreeding}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Female" Binding="{Binding Animal.EarTag}" Width="*"/>
                        <DataGridTextColumn Header="Male Sire" Binding="{Binding SireEarTag}" Width="*"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="1.2*"/>
                        <DataGridTextColumn Header="Mated" Binding="{Binding MatingDate, StringFormat=dd/MM/yyyy}" Width="*"/>
                        <DataGridTextColumn Header="Expected Delivery" Binding="{Binding ExpectedDelivery, StringFormat=dd/MM/yyyy}" Width="1.2*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="1.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
