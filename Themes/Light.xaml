<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Surface & Text Palettes (WCAG AA Compliant) -->
    <SolidColorBrush x:Key="Background" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="Border" Color="#D3DCE6"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#E5EAF0"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB"/>

    <!-- Sidebar Active & Hover States -->
    <SolidColorBrush x:Key="SidebarHover" Color="#E8EEF5"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#D9E3F0"/>
    <SolidColorBrush x:Key="SidebarActiveText" Color="#0F172A"/>

    <!-- Pastel Quick Stat Cards (Light variants with rich pastel backgrounds) -->
    <SolidColorBrush x:Key="CardBlue" Color="#E3EDF9"/>
    <SolidColorBrush x:Key="CardBlueText" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="CardGreen" Color="#E4F7EB"/>
    <SolidColorBrush x:Key="CardGreenText" Color="#15803D"/>
    <SolidColorBrush x:Key="CardYellow" Color="#FEF7DE"/>
    <SolidColorBrush x:Key="CardYellowText" Color="#A16207"/>
    <SolidColorBrush x:Key="CardLavender" Color="#F3EBFD"/>
    <SolidColorBrush x:Key="CardLavenderText" Color="#7E22CE"/>

    <!-- Badges & Tags -->
    <SolidColorBrush x:Key="BadgeActiveBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="BadgeActiveFg" Color="#166534"/>
    <SolidColorBrush x:Key="BadgeTagBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BadgeTagFg" Color="#1E40AF"/>

    <!-- Sign Out Button -->
    <SolidColorBrush x:Key="SignOutBg" Color="#EF4444"/>
    <SolidColorBrush x:Key="SignOutFg" Color="#FFFFFF"/>

    <!-- Hero Banner Gradients & Border -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8F1FD" Offset="0.0"/>
        <GradientStop Color="#F1F5F9" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroBorderBrush" Color="#BFDBFE"/>

    <!-- Recent Activity Pastel Card Backgrounds -->
    <SolidColorBrush x:Key="ActivityCardBg1" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="ActivityCardBg2" Color="#FAF5FF"/>
    <SolidColorBrush x:Key="ActivityCardBg3" Color="#FFFBEB"/>

    <!-- Legacy compatibility aliases for legacy windows -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D3DCE6"/>
    <SolidColorBrush x:Key="AltRowBrush" Color="#EDF2F7"/>

</ResourceDictionary>
