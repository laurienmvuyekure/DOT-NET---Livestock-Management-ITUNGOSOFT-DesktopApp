<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Surface & Text Palettes (WCAG AA Compliant) -->
    <SolidColorBrush x:Key="Background" Color="#0D1117"/>
    <SolidColorBrush x:Key="Surface" Color="#161B22"/>
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#21262D"/>
    <SolidColorBrush x:Key="Border" Color="#30363D"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#21262D"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6E7681"/>

    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#60A5FA"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#60A5FA"/>

    <!-- Sidebar Active & Hover States -->
    <SolidColorBrush x:Key="SidebarHover" Color="#1C2128"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#2D333B"/>
    <SolidColorBrush x:Key="SidebarActiveText" Color="#FFFFFF"/>

    <!-- Pastel Quick Stat Cards (Dark variants with WCAG text contrast) -->
    <SolidColorBrush x:Key="CardBlue" Color="#162236"/>
    <SolidColorBrush x:Key="CardBlueText" Color="#93C5FD"/>
    <SolidColorBrush x:Key="CardGreen" Color="#132B1F"/>
    <SolidColorBrush x:Key="CardGreenText" Color="#86EFAC"/>
    <SolidColorBrush x:Key="CardYellow" Color="#302613"/>
    <SolidColorBrush x:Key="CardYellowText" Color="#FDE047"/>
    <SolidColorBrush x:Key="CardLavender" Color="#251C36"/>
    <SolidColorBrush x:Key="CardLavenderText" Color="#D8B4FE"/>

    <!-- Badges & Tags -->
    <SolidColorBrush x:Key="BadgeActiveBg" Color="#132F20"/>
    <SolidColorBrush x:Key="BadgeActiveFg" Color="#4ADE80"/>
    <SolidColorBrush x:Key="BadgeTagBg" Color="#1E2E4A"/>
    <SolidColorBrush x:Key="BadgeTagFg" Color="#93C5FD"/>

    <!-- Sign Out Button -->
    <SolidColorBrush x:Key="SignOutBg" Color="#DC2626"/>
    <SolidColorBrush x:Key="SignOutFg" Color="#FFFFFF"/>

    <!-- Hero Banner Gradients & Border -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#162444" Offset="0.0"/>
        <GradientStop Color="#0D1322" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroBorderBrush" Color="#253A6E"/>

    <!-- Recent Activity Pastel Card Backgrounds -->
    <SolidColorBrush x:Key="ActivityCardBg1" Color="#182236"/>
    <SolidColorBrush x:Key="ActivityCardBg2" Color="#1C1E30"/>
    <SolidColorBrush x:Key="ActivityCardBg3" Color="#201C2E"/>

    <!-- Legacy compatibility aliases for legacy windows -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161B22"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B949E"/>
    <SolidColorBrush x:Key="LineBrush" Color="#30363D"/>
    <SolidColorBrush x:Key="AltRowBrush" Color="#21262D"/>

</ResourceDictionary>
